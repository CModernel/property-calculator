# PCALC-116: without this, a Node version outside package.json's `engines`
# installs anyway (npm only warns) and then fails at runtime in a way that
# names nothing useful - jsdom 30 on Node 20 crashed all 42 jsdom test workers
# with "webidl.util.markAsUncloneable is not a function" while the 36
# node-environment files passed, which reads like a test bug rather than a
# Node version mismatch. Fail at install, where the message is actionable.
engine-strict=true
